#!/usr/bin/env bash
# Optional interactive setup: native launcher or Compose service.
#
# Writes exactly the same validated files as the non-interactive path, because
# scripts/pennyroyal/penny_setup.py shares scripts/pennyroyal/penny_config.py.
# It only writes configuration and prints the next command: no downloads, no
# package installs, no service or container start, no model load, no cache
# deletion, no ownership change, no sudo, no network access.
#
# Usage: ./configure-penny [--container] [--config PATH] [--check] [--yes]
#   (no arguments)   interactive setup for the native launcher
#   --container      interactive setup for the Compose service and its .env
#   --config PATH    read and write this file instead of the default one
#   --check          validate a saved config without a GPU and exit
#   --show-config    print the resolved configuration and launch command
#   --yes            accept the save confirmation (scripted runs)
#   --help, -h       this help and the setup utility's option list
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SETUP_UTILITY="$ROOT/scripts/pennyroyal/penny_setup.py"
PYTHON="${PENNY_PYTHON:-python3}"
command -v "$PYTHON" >/dev/null 2>&1 || {
  echo "python3 is required to write the saved configuration" >&2
  exit 1
}

case " $* " in
  *" --help "* | *" -h "*)
    sed -n '10,17p' "${BASH_SOURCE[0]}" | cut -c 3-
    exec "$PYTHON" "$SETUP_UTILITY" --help ;;
esac

exec "$PYTHON" "$SETUP_UTILITY" "$@"
