diff --git a/csrc/fused_moe/cutlass_backend/cutlass_fused_moe_kernels.cuh b/csrc/fused_moe/cutlass_backend/cutlass_fused_moe_kernels.cuh
index b43cf5a..d3931c8 100644
--- a/csrc/fused_moe/cutlass_backend/cutlass_fused_moe_kernels.cuh
+++ b/csrc/fused_moe/cutlass_backend/cutlass_fused_moe_kernels.cuh
@@ -1571,6 +1571,334 @@ __host__ __device__ constexpr static U arrayConvert(T const& input) {
 // (k-1)*rows_in_input all map to row 0 in the original matrix. Thus, to know where to read in the
 // source matrix, we simply take the modulus of the expanded index.
 
+// ============ G2-2: routing prologue fused with the row expansion (input preparation) ==========
+//
+// expandInputRowsKernel needs nothing from the routing side but the row maps and the expert
+// offsets the prologue has just produced, and the stride/descriptor setup does not read what it
+// writes -- so the row phase can ride along in the prologue launch instead of being a second
+// serial launch of its own.  As in A0/A3 every block re-runs the cheap, deterministic rank so no
+// grid-wide barrier is needed; block 0 publishes the routing maps and offsets, and every block
+// stages the rows it owns out of block-local copies of the inverse row/expert maps, which is also
+// what buys the fused path the expert id without the binary search
+// (findTotalEltsLessThanTarget) the standalone kernel pays per row.
+//
+// Deliberately NOT fused here: computeStridesTmaWarpSpecializedKernel stays its own launch in its
+// usual place (after this, from setupTmaWarpSpecializedInputs).  This kernel takes no layout_info,
+// problem shape or weight pointer at all, which is the separation from the rejected donor A3.
+//
+// Restricted to BLOCK_SIZE = 32 (num_tokens <= 32, i.e. decode/verify) and LOG2_NUM_EXPERTS = 10
+// (num_experts_per_node + 1 < 1024) to keep the instantiation count to one per top-k value per
+// runner type.  Everything else keeps the accepted A0 prologue plus the standalone
+// expandInputRowsKernel, and FLASHINFER_MOE_FOLD_EXPAND=0 restores that pair at any shape.
+
+// The maximum number of 8-element chunks one thread stages per row.  hidden_size /
+// (8 * BLOCK_SIZE) must be <= this; the host gate refuses the fusion otherwise.
+constexpr int G2_EXPAND_MAX_CHUNKS = 16;
+
+template <class T, class InputAct, int BLOCK_SIZE, int EXPERTS_PER_TOKEN, int LOG2_NUM_EXPERTS>
+__global__ void fusedBuildExpertMapsSortFirstTokenAndExpandKernel(
+    int const* const token_selected_experts, int* const permuted_row_to_unpermuted_row,
+    int* const unpermuted_row_to_permuted_row, int64_t* const expert_first_token_offset,
+    int64_t const num_tokens, int const start_expert, int const end_expert,
+    int const num_experts_per_node, InputAct const* expand_input, T* expand_output,
+    float const* expand_unpermuted_scales, float* expand_permuted_scales,
+    TmaWarpSpecializedGroupedGemmInput::ElementSF* expand_act_sf_flat,
+    float const* expand_act_global_scale, bool expand_use_per_expert_act_scale,
+    int64_t expand_hidden_size) {
+  using BlockRadixRank = FusedPrologueRadixRank<BLOCK_SIZE, LOG2_NUM_EXPERTS>;
+  static_assert(BlockRadixRank::BINS_TRACKED_PER_THREAD * BLOCK_SIZE >= (1 << LOG2_NUM_EXPERTS));
+  assert(num_experts_per_node < (1 << LOG2_NUM_EXPERTS));
+  assert(num_experts_per_node == (end_expert - start_expert));
+
+  extern __shared__ unsigned char temp_storage[];
+  auto& sort_temp = *reinterpret_cast<typename BlockRadixRank::TempStorage*>(temp_storage);
+  int* const shared_offsets =
+      reinterpret_cast<int*>(temp_storage + sizeof(typename BlockRadixRank::TempStorage));
+  // The inverse permutation and the per-permuted-row expert id.  Every block re-runs the rank, so
+  // these are block-local: no global round trip and no grid barrier.
+  int* const shared_inv_row = shared_offsets + (num_experts_per_node + 1);
+  int* const shared_inv_expert = shared_inv_row + BLOCK_SIZE * EXPERTS_PER_TOKEN;
+
+  int const token = threadIdx.x;
+  bool const is_valid_token = token < num_tokens;
+
+  // This is the masked expert id for this token
+  int local_token_selected_experts[EXPERTS_PER_TOKEN];
+  // This is the final permuted rank of this token (ranked by selected expert)
+  int local_token_permuted_indices[EXPERTS_PER_TOKEN];
+
+  // Wait PDL before reading token_selected_experts (and the row input below)
+#if (defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900))
+  cudaGridDependencySynchronize();
+#endif
+
+// build expert map
+// we need to populate expert ids for all threads, even if there are
+// fewer tokens
+#pragma unroll
+  for (int i = 0; i < EXPERTS_PER_TOKEN; i++) {
+    int const expert = is_valid_token ? token_selected_experts[token * EXPERTS_PER_TOKEN + i]
+                                      : num_experts_per_node;
+
+    // If the token is not valid, set the expert id to num_experts_per_node + 1
+    // If expert is not in the current node, set it to num_experts_per_node
+    // If expert is in the current node, subtract start_expert to shift the range to [0,
+    // num_experts_per_node)
+    bool is_valid_expert = expert >= start_expert && expert < end_expert;
+    local_token_selected_experts[i] = !is_valid_token   ? num_experts_per_node + 1
+                                      : is_valid_expert ? (expert - start_expert)
+                                                        : num_experts_per_node;
+  }
+
+  int local_expert_first_token_offset[BlockRadixRank::BINS_TRACKED_PER_THREAD];
+  cub::BFEDigitExtractor<int> extractor(0, LOG2_NUM_EXPERTS);
+  BlockRadixRank(sort_temp).RankKeys(local_token_selected_experts, local_token_permuted_indices,
+                                     extractor, local_expert_first_token_offset);
+
+  // RankKeys gives BLOCK_SIZE * EXPERTS_PER_TOKEN distinct ranks, so these writes never collide
+  // (invalid tokens rank past num_valid_rows and are simply never read back).
+#pragma unroll
+  for (int i = 0; i < EXPERTS_PER_TOKEN; i++) {
+    int const permuted_row = local_token_permuted_indices[i];
+    shared_inv_row[permuted_row] = i * static_cast<int>(num_tokens) + token;
+    shared_inv_expert[permuted_row] = local_token_selected_experts[i];
+  }
+
+  bool const writer_block = blockIdx.x == 0;
+  if (writer_block && is_valid_token) {
+#pragma unroll
+    for (int i = 0; i < EXPERTS_PER_TOKEN; i++) {
+      int const unpermuted_row = i * static_cast<int>(num_tokens) + token;
+      int const permuted_row = local_token_permuted_indices[i];
+      permuted_row_to_unpermuted_row[permuted_row] = unpermuted_row;
+      unpermuted_row_to_permuted_row[unpermuted_row] = permuted_row;
+    }
+  }
+
+#pragma unroll
+  for (int expert_id = 0; expert_id < BlockRadixRank::BINS_TRACKED_PER_THREAD; expert_id++) {
+    int out_expert_id = expert_id + token * BlockRadixRank::BINS_TRACKED_PER_THREAD;
+    if (out_expert_id < num_experts_per_node + 1) {
+      shared_offsets[out_expert_id] = local_expert_first_token_offset[expert_id];
+      if (writer_block) {
+        expert_first_token_offset[out_expert_id] = local_expert_first_token_offset[expert_id];
+      }
+    }
+  }
+  __syncthreads();
+
+  // The stride setup that follows is a separate launch and only reads expert_first_token_offset,
+  // which is published above, so release the dependent grid here (as the A0 kernel does) and let
+  // its launch overlap the row phase below.  That kernel's own cudaGridDependencySynchronize still
+  // waits for this grid's stores, so the permuted rows are visible before anything reads them.
+#if (defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900))
+  cudaTriggerProgrammaticLaunchCompletion();
+#endif
+
+#ifdef ENABLE_FP4
+  if constexpr (std::is_same_v<T, Fp4Type> &&
+                (std::is_same_v<InputAct, __nv_bfloat16> || std::is_same_v<InputAct, half>)) {
+    // ---- expandInputRowsKernel, folded in (the host gate guarantees the tag selection below)
+    constexpr int64_t ELEM_PER_THREAD = CVT_ELTS_PER_THREAD;  // 8
+    constexpr int VecSize = TmaWarpSpecializedGroupedGemmInput::NVFP4BlockScaleVectorSize;
+    constexpr int64_t min_k_dim_alignment =
+        TmaWarpSpecializedGroupedGemmInput::MinKDimAlignmentNVFP4;
+    using DataElem = cutlass::Array<InputAct, ELEM_PER_THREAD>;
+    using OutputElem = uint32_t;
+
+    int64_t const padded_hidden_size =
+        TmaWarpSpecializedGroupedGemmInput::alignToSfDim(expand_hidden_size, min_k_dim_alignment);
+    int64_t const num_elems_in_col = expand_hidden_size / ELEM_PER_THREAD;
+    int const trips = static_cast<int>(num_elems_in_col) / BLOCK_SIZE;  // exact, host-gated
+    int64_t const num_valid_rows = shared_offsets[num_experts_per_node];
+
+    for (int64_t permuted_row = blockIdx.x; permuted_row < num_valid_rows;
+         permuted_row += gridDim.x) {
+      int const unpermuted_row = shared_inv_row[permuted_row];
+      int const row_expert = shared_inv_expert[permuted_row];
+      int64_t const num_tokens_before_expert = shared_offsets[row_expert];
+      float const global_scale_val =
+          expand_act_global_scale
+              ? expand_act_global_scale[expand_use_per_expert_act_scale ? row_expert : 0]
+              : 1.0f;
+      int64_t const source_row = unpermuted_row % num_tokens;
+      int64_t const source_k_rank = unpermuted_row / num_tokens;
+
+      auto const* source_row_ptr =
+          reinterpret_cast<DataElem const*>(expand_input + source_row * expand_hidden_size);
+      auto* dest_row_ptr =
+          reinterpret_cast<OutputElem*>(expand_output) + permuted_row * num_elems_in_col;
+      // The same row-alignment assumptions expandInputRowsKernelLauncher checks on the host.
+      assert(reinterpret_cast<std::uintptr_t>(source_row_ptr) % sizeof(DataElem) == 0);
+      assert(reinterpret_cast<std::uintptr_t>(dest_row_ptr) % sizeof(OutputElem) == 0);
+
+      // Stage the whole row in registers first: with one warp per row the loads must all be in
+      // flight at once, or the dependent round trips cost more than the launch we deleted.
+      DataElem staged[G2_EXPAND_MAX_CHUNKS];
+#pragma unroll
+      for (int chunk = 0; chunk < G2_EXPAND_MAX_CHUNKS; chunk++) {
+        if (chunk < trips) {
+          staged[chunk] = source_row_ptr[threadIdx.x + chunk * BLOCK_SIZE];
+        }
+      }
+#pragma unroll
+      for (int chunk = 0; chunk < G2_EXPAND_MAX_CHUNKS; chunk++) {
+        if (chunk < trips) {
+          int64_t const elem_index = threadIdx.x + chunk * BLOCK_SIZE;
+          auto res =
+              quantizePackedFPXValue<InputAct, T, DataElem, VecSize, false, std::false_type>(
+                  staged[chunk], global_scale_val, num_tokens_before_expert, row_expert,
+                  permuted_row, elem_index, padded_hidden_size, expand_act_sf_flat,
+                  TmaWarpSpecializedGroupedGemmInput::FpXBlockScalingType::NVFP4);
+          static_assert(sizeof(res) == sizeof(*dest_row_ptr),
+                        "Quantized value must be the same size as the output");
+          dest_row_ptr[elem_index] = res;
+        }
+      }
+
+      // K-dim SF padding, exactly as expandInputRowsKernel does it (a no-op whenever the hidden
+      // size needs no padding, which is every shape the host gate accepts).
+      for (int64_t elem_index = expand_hidden_size / VecSize + threadIdx.x;
+           elem_index < padded_hidden_size / VecSize; elem_index += BLOCK_SIZE) {
+        writeSF<VecSize, VecSize>(num_tokens_before_expert, row_expert, /*source_row*/ -1,
+                                  permuted_row, elem_index, padded_hidden_size,
+                                  expand_act_sf_flat, /*input_sf*/ nullptr);
+      }
+
+      if (expand_permuted_scales && threadIdx.x == 0) {
+        int64_t const source_k_idx = source_row * EXPERTS_PER_TOKEN + source_k_rank;
+        expand_permuted_scales[permuted_row] =
+            expand_unpermuted_scales ? expand_unpermuted_scales[source_k_idx] : 1.0f;
+      }
+    }
+  }
+#endif
+}
+
+// FLASHINFER_MOE_FOLD_EXPAND=0 keeps expandInputRowsKernel as its own launch.
+inline bool foldExpandEnabled() {
+  static bool const enabled = [] {
+    char const* v = std::getenv("FLASHINFER_MOE_FOLD_EXPAND");
+    return !(v && v[0] == '0' && v[1] == '\0');
+  }();
+  return enabled;
+}
+
+template <class T, class InputAct, int EXPERTS_PER_TOKEN>
+bool launchFusedPrologueAndExpand(FusedPrologueRequest& req, int const num_experts_per_node,
+                                  bool enable_pdl, cudaStream_t stream) {
+  constexpr int BLOCK_SIZE = 32;
+  constexpr int LOG2_NUM_EXPERTS = 10;
+  using BlockRadixRank = FusedPrologueRadixRank<BLOCK_SIZE, LOG2_NUM_EXPERTS>;
+
+  size_t const shared_size = sizeof(typename BlockRadixRank::TempStorage) +
+                             sizeof(int) * static_cast<size_t>(num_experts_per_node + 1) +
+                             2 * sizeof(int) * static_cast<size_t>(BLOCK_SIZE) *
+                                 static_cast<size_t>(EXPERTS_PER_TOKEN);
+
+  int device = 0;
+  int max_smem_per_block = 0;
+  check_cuda_error(cudaGetDevice(&device));
+  check_cuda_error(
+      cudaDeviceGetAttribute(&max_smem_per_block, cudaDevAttrMaxSharedMemoryPerBlockOptin, device));
+  if (shared_size >= static_cast<size_t>(max_smem_per_block)) {
+    return false;
+  }
+
