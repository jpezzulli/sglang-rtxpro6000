+      }
     }
   } else if (use_fp8) {
     alpha_scale_ptr_array = computeFP8DequantScale(alpha_scale_ptr_array, num_experts_per_node,
@@ -3800,7 +3831,7 @@ void CutlassMoeFCRunner<T, WeightType, OutputType, InputType, BackBoneType, IsMX
                       static_cast<ScaleBiasType const*>(fc2_lora), false, expert_first_token_offset,
                       /*permuted_token_selected_experts=*/nullptr, num_experts_per_node,
                       hidden_size, expanded_num_rows, ActivationParams(ActivationType::Identity),
-                      {}, false, nullptr, nullptr, nullptr, enable_pdl, stream);
+                      {}, false, nullptr, nullptr, nullptr, enable_pdl, stream, nullptr, 0);
     sync_check_cuda_error(stream);
   }
 
@@ -4392,6 +4423,26 @@ void CutlassMoeFCRunner<
                              num_valid_tokens_ptr, expanded_num_rows, hidden_size, use_awq, stream);
     }
     sync_check_cuda_error(stream);
+
+    // G2-1: the fused-finalize output zeroing is a ~1.0 us memset32 launch sitting between
+    // doActivationKernel and GEMM2 in a strictly serial chain.  Hand it to doActivationKernel's
+    // grid instead (same position in the stream, one fewer launch).  Fails safe: any condition
+    // we do not cover leaves the memset where it was.
+    void* fused_zero_ptr = nullptr;
+    int64_t fused_zero_vec16 = 0;
+    if (foldMemsetEnabled() && !min_latency_mode &&
+        gemm2_tma_ws_input.fusion ==
+            TmaWarpSpecializedGroupedGemmInput::EpilogueFusion::FINALIZE &&
+        moe_gemm_runner_.isTmaWarpSpecialized(*gemm1_config_) && !use_lora &&
