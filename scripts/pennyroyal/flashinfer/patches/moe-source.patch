From 5e86c489f5759cb4006d3b1b5e7bdd14f7a581df Mon Sep 17 00:00:00 2001
From: Penny <Pennyroyal@agentmail.to>
Date: Thu, 8 Oct 2026 16:42:07 -0400
Subject: [PATCH 1/3] perf(moe): port the donor A0 fused routing prologue to
 512 experts / top-10

Direct port of the published donor patch, kept at the text level: every added and
removed line of csrc/fused_moe/cutlass_backend/cutlass_fused_moe_kernels.cuh is
byte-identical to

  https://github.com/aiueo52/flash-next-rtxpro6000 @ 524af49abcca66fcb4377ba8297022804535fccf
  patches/flashinfer/01-a0-fused-routing-prologue.patch

(benches/optimizations documented in that repo's docs/optimizations.md section D1,
"Flash-Next" work by aiueo52; the wheel-side copy of the file,
flashinfer/data/csrc/fused_moe/cutlass_backend/cutlass_fused_moe_kernels.cuh, is
byte-identical to the one in the flashinfer_python-0.7.0.post1 wheel, so the only
mechanical 0.7 change is the source-repo path and the resulting line offsets).

FlashInfer has a one-kernel routing prologue, fusedBuildExpertMapsSortFirstToken,
but on this base it cannot be reached by the Flash-Next model shape: expert_log = 10
fell outside the `expert_log <= 9` tier and top-k = 10 was absent from the
{1,2,4,6,8} dispatch, so the 512-expert / top-10 route always ran the 3-kernel
unfused preparation.  Enabling both gates naively is slower than the fallback it
replaces (~15 us vs 9.4 us), because cub::BlockRadixRank's temp storage is
COUNTER_LANES * BLOCK_THREADS * PACKING_RATIO digit counters, 65,696 B at
BLOCK_SIZE=32 / RADIX_BITS=10 (512 experts + the num_experts / num_experts+1
sentinels), which 32 threads then zero and rake.  The donor therefore switches only
the >=10-bit tier, which upstream never reached, to cub::BlockRadixRankMatch
(one counter per (digit, warp), 4,256 B here, ranks via warp match_any); measured
3.36 us/call.  Every configuration with expert_log <= 9 keeps cub::BlockRadixRank
bit-for-bit through the FusedPrologueRadixRank alias.

What is preserved: existing <=9-bit ranker behaviour, the num_experts_per_node /
num_experts_per_node + 1 sentinel selection, the PDL
cudaGridDependencySynchronize/cudaTriggerProgrammaticLaunchCompletion pairing and
the per-launch ProgrammaticStreamSerialization attribute, the single-block and
<=256-token gates, the token-row maps and the start_expert/end_expert TP2/EP range
semantics, and the `if (!fused_prologue_result)` fallback to
threeStepBuildExpertMapsSortFirstToken for option-off and larger/unsupported shapes.
Selected experts and routing weights are unchanged; nothing is capped, dropped or
reweighted.  FLASHINFER_MOE_FUSED_PROLOGUE=0 is the kill switch (default on), read
once per process before the expert_log dispatch.

tests/moe/test_cutlass_fused_moe_a0_prologue.py is the target-GPU half of the check:
fused vs kill-switched runs must be bit-identical at the new and pre-existing tiers
(a fixed tactic and use_fused_finalize=False make the MoE output a strict function of
the three prologue products), and NVFP4 output must still match the fp4-dequantised
reference, including the >256-token shape that must fall back.  Not run here: this
checkout host has no CUDA toolchain, no GPU and a CPU-only torch.
---
 .../cutlass_fused_moe_kernels.cuh             | 40 +++++++++++++++++--
 1 file changed, 36 insertions(+), 4 deletions(-)

diff --git a/csrc/fused_moe/cutlass_backend/cutlass_fused_moe_kernels.cuh b/csrc/fused_moe/cutlass_backend/cutlass_fused_moe_kernels.cuh
index cb77222..60ed9b8 100644
--- a/csrc/fused_moe/cutlass_backend/cutlass_fused_moe_kernels.cuh
+++ b/csrc/fused_moe/cutlass_backend/cutlass_fused_moe_kernels.cuh
@@ -72,6 +72,8 @@
 #include "3rdparty/cub/cub.cuh"
 #endif
 
+#include <cstdlib>
+
 using namespace tensorrt_llm::kernels;
 using namespace tensorrt_llm::common;
 
@@ -407,6 +409,19 @@ void buildMinLatencyActiveExpertMaps(
                      smart_routing, cluster_rank, cluster_size, num_experts_smem);
 }
 
+// A0: cub::BlockRadixRank's temp storage is COUNTER_LANES * BLOCK_THREADS * PACKING_RATIO
+// digit counters, i.e. 64 KiB at BLOCK_SIZE=32 / RADIX_BITS=10 (512 experts + sentinel).
+// Zeroing and raking that with 32 threads costs ~15 us -- more than the 3-kernel fallback it
+// replaces.  BlockRadixRankMatch keeps one counter per (digit, warp) instead (~4 KiB here) and
+// ranks with warp match_any, so it is ~10x cheaper at this block size.  Only the >=10-bit tier
+// (which upstream never reached) switches over; every existing configuration keeps
+// cub::BlockRadixRank bit-for-bit.
+template <int BLOCK_SIZE, int LOG2_NUM_EXPERTS>
+using FusedPrologueRadixRank =
+    ::cuda::std::conditional_t<(LOG2_NUM_EXPERTS >= 10),
+                               cub::BlockRadixRankMatch<BLOCK_SIZE, LOG2_NUM_EXPERTS, false>,
+                               cub::BlockRadixRank<BLOCK_SIZE, LOG2_NUM_EXPERTS, false>>;
+
 template <int BLOCK_SIZE, int EXPERTS_PER_TOKEN, int LOG2_NUM_EXPERTS>
 __global__ void fusedBuildExpertMapsSortFirstTokenKernel(
     int const* const token_selected_experts, int* const permuted_row_to_unpermuted_row,
@@ -456,7 +471,7 @@ __global__ void fusedBuildExpertMapsSortFirstTokenKernel(
   // that to elide the binary search
 
   // sort the expert map
-  using BlockRadixRank = cub::BlockRadixRank<BLOCK_SIZE, LOG2_NUM_EXPERTS, false>;
+  using BlockRadixRank = FusedPrologueRadixRank<BLOCK_SIZE, LOG2_NUM_EXPERTS>;
   extern __shared__ unsigned char temp_storage[];
   auto& sort_temp = *reinterpret_cast<typename BlockRadixRank::TempStorage*>(temp_storage);
 
@@ -507,7 +522,7 @@ bool fusedBuildExpertMapsSortFirstTokenDispatch(
   int const blocks = (num_tokens + threads - 1) / threads;
   TLLM_CHECK_WITH_INFO(blocks == 1, "Current implementation requires single block");
 
-  using BlockRadixRank = cub::BlockRadixRank<BLOCK_SIZE, LOG2_NUM_EXPERTS, false>;
+  using BlockRadixRank = FusedPrologueRadixRank<BLOCK_SIZE, LOG2_NUM_EXPERTS>;
   size_t shared_size = sizeof(typename BlockRadixRank::TempStorage);
 
   cudaLaunchConfig_t config;
@@ -603,6 +618,10 @@ bool fusedBuildExpertMapsSortFirstTokenBlockSize(
       func = &fusedBuildExpertMapsSortFirstTokenBlockSize<8, LOG2_NUM_EXPERTS>;
       break;
     }
+    case 10: {
+      func = &fusedBuildExpertMapsSortFirstTokenBlockSize<10, LOG2_NUM_EXPERTS>;
+      break;
+    }
     default: {
       TLLM_LOG_TRACE("Top-K value %d does not have supported fused moe prologues",
                      experts_per_token);
@@ -615,15 +634,27 @@ bool fusedBuildExpertMapsSortFirstTokenBlockSize(
               stream);
 }
 
+// FLASHINFER_MOE_FUSED_PROLOGUE=0 forces the unfused 3-kernel prologue (A0 kill switch).
+inline bool fusedPrologueEnabled() {
+  static bool const enabled = [] {
+    char const* v = std::getenv("FLASHINFER_MOE_FUSED_PROLOGUE");
+    return !(v && v[0] == '0' && v[1] == '\0');
+  }();
+  return enabled;
+}
+
 bool fusedBuildExpertMapsSortFirstToken(
     int const* token_selected_experts, int* permuted_row_to_unpermuted_row,
     int* unpermuted_row_to_permuted_row, int64_t* expert_first_token_offset,
     int64_t const num_tokens, int const num_experts_per_node, int const experts_per_token,
     int const start_expert, int const end_expert, bool enable_pdl, cudaStream_t stream) {
+  if (!fusedPrologueEnabled()) {
+    return false;
+  }
   // We need enough bits to represent [0, num_experts_per_node+1] (inclusive) i.e.
   // num_experts_per_node + 2 values This is floor(log2(num_experts_per_node+1)) + 1
   int expert_log = static_cast<int>(log2(num_experts_per_node + 1)) + 1;
-  if (expert_log <= 9) {
+  if (expert_log <= 10) {
     auto funcs = std::array{&fusedBuildExpertMapsSortFirstTokenBlockSize<1>,
                             &fusedBuildExpertMapsSortFirstTokenBlockSize<2>,
                             &fusedBuildExpertMapsSortFirstTokenBlockSize<3>,
@@ -632,7 +663,8 @@ bool fusedBuildExpertMapsSortFirstToken(
                             &fusedBuildExpertMapsSortFirstTokenBlockSize<6>,
                             &fusedBuildExpertMapsSortFirstTokenBlockSize<7>,
                             &fusedBuildExpertMapsSortFirstTokenBlockSize<8>,
-                            &fusedBuildExpertMapsSortFirstTokenBlockSize<9>};
+                            &fusedBuildExpertMapsSortFirstTokenBlockSize<9>,
+                            &fusedBuildExpertMapsSortFirstTokenBlockSize<10>};
 
     return funcs[expert_log - 1](token_selected_experts, permuted_row_to_unpermuted_row,
                                  unpermuted_row_to_permuted_row, expert_first_token_offset,
-- 
