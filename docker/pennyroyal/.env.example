# Copy to .env next to compose.yaml, or run ./configure-penny --container
# from the repository root. Set your paths and choose a profile below.
# The setup utility's printed command uses your saved settings. With plain
# docker compose, exported shell variables override .env; unset conflicting
# exports to use this file. Do not source this file as a shell script.

# Start here: the profile and the directories.
PENNYROYAL_PROFILE=next
PENNYROYAL_IMAGE=ghcr.io/jpezzulli/sglang-rtxpro6000:v2.5.1
PENNYROYAL_PORT=8001

# Mount a parent directory when checkpoints contain symlinks to sibling paths.
HOST_MODELS_ROOT=/srv/models
HOST_CACHE_BASE=/var/cache/pennyroyal
HOST_NIXL_STORAGE_BASE=/srv/pennyroyal-nixl

# Use the numeric identity that owns the writable cache directories.
# Do not use UID as the variable name: Bash reserves it as a readonly variable.
USER_ID=1000
GROUP_ID=1000

# Host GPU selected for the model: an index from nvidia-smi or a UUID. Compose
# reserves exactly this one device. Advanced multi-GPU topology overrides stay
# a manual Compose edit; this starter does not generate them. See README.md for
# a second-GPU override.
NVIDIA_GPU=0

# Soft byte budget for the NIXL FILE cache's configured dirs, in GiB (0 disables).
SGLANG_HICACHE_NIXL_MAX_CACHE_GB=0

# Paths below are inside the container's /models mount.
# For 27b, also change TARGET_MODEL to your 27B FP8 checkpoint, for example
# /models/Qwen3.8-27B-FP8. Switching the profile does not select a model for
# you; leaving TARGET_MODEL empty makes the setup utility choose the path that
# matches the selected profile.
TARGET_MODEL=/models/RadixArk-Qwen3.8-Flash-Next-NVFP4
DRAFT_MODEL=/models/Qwen3.8-27B-DFlash2

# --- Advanced (optional): delete the leading '#' to change a value. ----------
# These are the recipe options the Compose file already forwards, and the
# values shown are the public recipe defaults. Nothing here enables extra
# tuning automatically.

# RAM PLE and original checkpoint precision are the public recipe defaults.
#PENNY_PLE_BACKEND=ram
#PENNY_PLE_NVME_MODEL=/models/flash-next-ple
#SGLANG_SM120_ONLINE_MXFP8=false
#SGLANG_MM_PREPROCESS_DEVICE=cpu
#SGLANG_FORWARD_UNKNOWN_TOOLS=true

# Flash-Next request/state capacity. Defaults remain four requests / 24 slots.
# For the optional C6 profile, see README.md: enable online FP8, use 6 / 36,
# and request MAX_TOTAL_TOKENS=1048576. SGLang reports the actual fitted pool.
#MAX_RUNNING_REQUESTS=4
#MAX_MAMBA_CACHE_SIZE=24
#MAX_TOTAL_TOKENS=

# Optional launcher knobs: medium reasoning, TP1 and untouched NCCL by default.
#PENNY_REASONING_EFFORT=
#TP_SIZE=
#NCCL_P2P_DISABLE=
